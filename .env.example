# 环境变量示例文件
#
# 用法：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 排除，绝不要提交。
# 本文件（.env.example）中不得出现任何真实 API Key、Token 或凭据。
#
# 复制命令：cp .env.example .env

# ── 模型调用配置（@anthropic-ai/sdk） ──
# 模型服务 API Key。使用 Anthropic-compatible 端点时填该服务签发的 Key。
ANTHROPIC_API_KEY=

# API 基础地址。
# - 使用 Anthropic 官方服务时留空
# - 使用 Anthropic-compatible 端点时填写该服务的 base URL
ANTHROPIC_BASE_URL=

# 模型名称，由所选服务决定
ANTHROPIC_MODEL=

# ── 后端服务 ──
# Express 监听端口
PORT=3000

# 运行环境：development | production
NODE_ENV=development
